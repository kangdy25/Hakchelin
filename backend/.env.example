# Django
DJANGO_SECRET_KEY=unsafe-local-development-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# 비워두면 로컬 SQLite를 사용한다.
# PostgreSQL 사용 시 postgresql://... 형식의 URL을 설정한다.
DATABASE_URL=

# 비워두면 pytest는 인메모리 SQLite를 사용한다.
# PostgreSQL 동시성 테스트에는 별도 테스트 DB URL을 설정한다.
TEST_DATABASE_URL=
DATABASE_CONN_MAX_AGE=0

# Application control
DJANGO_WRITE_BLOCKED=false

# Browser security
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_COOKIE_DOMAIN=
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# Celery and Redis
# 백엔드와 Redis를 직접 실행하는 로컬 개발 기준이다.
# Docker Compose 내부에서는 호스트명을 redis로 변경한다.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Toss Payments
TOSS_PAYMENTS_SECRET_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=45