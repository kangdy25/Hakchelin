[Unit]
Description=Hakchelin production health check
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/hakchelin
ExecStart=/opt/hakchelin/infra/lightsail/scripts/check-service-health.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
